[Desktop Entry]
Type=Application
Name=Omarchy Audacity
GenericName=Sound Editor
Comment=Record and edit audio files; drag the window by its toolbars
Exec=omarchy-audacity %F
Icon=omarchy-audacity
Terminal=false
StartupNotify=false
StartupWMClass=Audacity
